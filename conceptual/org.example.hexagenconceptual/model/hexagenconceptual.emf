@namespace(
  uri="http://www.hexagen.org/conceptual",
  prefix="conceptual"
)
package hexagen;

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/conceptualmodel.png")
class ConceptualModel extends NamedElement {
  val Entity[*] entities;
  val ValueObject[*] valueObjects;
  val Relationship[*] relationships;
  val Service[*] services;
}

abstract class NamedElement {
  attr String name;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/entity.png")
class Entity extends NamedElement {
  val Attribute[*] attributes;
  val Relationship[*] relationships;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/valueobject.png")
class ValueObject extends NamedElement {
  val Attribute[*] attributes;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/parameter.png")
class Parameter extends NamedElement {
  attr String type;
  attr Boolean required;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/operation.png")
class Operation extends NamedElement {
  attr String returnType;
  val Parameter[*] parameters;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/service.png")
class Service extends NamedElement {
  val Operation[*] operations;
  ref Entity[*] entities;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/subDomain.png")
class SubDomain extends NamedElement {
  ref Service[*] services;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/domain.png")
class Domain extends NamedElement {
  val SubDomain[*] subDomains;
  val ConceptualModel[*] conceptualModels;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/attribute.png")
class Attribute extends NamedElement {
  attr String type;
  attr Boolean required;
}

@exeed(classIcon="platform:/resource/org.example.hexagenconceptual/icons/relationship.png")
class Relationship extends NamedElement {
  ref Entity source;
  ref Entity target;
  attr String type;
}