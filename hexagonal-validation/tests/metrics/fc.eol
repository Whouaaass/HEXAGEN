// FC: Functional Completeness
// Counts generated elements and computes ratio against expected.
// Expected counts derived from HMM source model (loaded as "HMM").
// Score: 5 = >=95%, 4 = >=80%, 3 = >=60%, 2 = >=40%, 1 = <40%

// -- Generated counts from SMM --
var totalGenerated = 0;
var genDetail = new Map;

for (app in SMM!Application.allInstances()) {
    for (mod in app.modules) {
        totalGenerated := totalGenerated + mod.entities.size();
        totalGenerated := totalGenerated + mod.valueObjects.size();
        totalGenerated := totalGenerated + mod.repositories.size();
        totalGenerated := totalGenerated + mod.services.size();
        totalGenerated := totalGenerated + mod.controllers.size();
        totalGenerated := totalGenerated + mod.dtos.size();

        genDetail.put("Entities", mod.entities.size());
        genDetail.put("ValueObjects", mod.valueObjects.size());
        genDetail.put("Repositories", mod.repositories.size());
        genDetail.put("Services", mod.services.size());
        genDetail.put("Controllers", mod.controllers.size());
        genDetail.put("DTOs", mod.dtos.size());
    }
}

// -- Expected counts from HMM --
var hmmHex = HMM!Hexagon.allInstances().first();
var hmmEntities = 0;
var hmmValueObjects = 0;
var dtoNames = new Set;

for (agg in hmmHex.domain.aggregates) {
    hmmEntities := hmmEntities + 1;
    for (m in agg.members) {
        if (m.isTypeOf(HMM!Entity)) { hmmEntities := hmmEntities + 1; }
        if (m.isTypeOf(HMM!ValueObject)) { hmmValueObjects := hmmValueObjects + 1; }
    }
}

var hmmRepoPorts = hmmHex.infrastructure.ports
    ->select(p | p.isTypeOf(HMM!OutboundPort) and p.name.indexOf("Repository") >= 0).size();

var hmmServices = hmmHex.application.services.size();

var hmmControllers = hmmHex.infrastructure.adapters
    ->select(a | a.isTypeOf(HMM!InboundAdapter)).size();

for (svc in hmmHex.application.services) {
    for (uc in svc.useCases) {
        for (io in uc.input) {
            if (io.isTypeOf(HMM!ValueObject)) { dtoNames.add(io.name); }
        }
        for (io in uc.output) {
            if (io.isTypeOf(HMM!ValueObject)) { dtoNames.add(io.name); }
        }
    }
}
var hmmDtos = dtoNames.size();

var expectedDetail = new Map;
expectedDetail.put("Entities", hmmEntities);
expectedDetail.put("ValueObjects", hmmValueObjects);
expectedDetail.put("Repositories", hmmRepoPorts);
expectedDetail.put("Services", hmmServices);
expectedDetail.put("Controllers", hmmControllers);
expectedDetail.put("DTOs", hmmDtos);

var expectedElements = hmmEntities + hmmValueObjects + hmmRepoPorts + hmmServices + hmmControllers + hmmDtos;

// -- Report --
("--- FC: Functional Completeness ---").println();
("Element counts:").println();
for (key in genDetail.keySet()) {
    var exp = expectedDetail.get(key);
    var gen = genDetail.get(key);
    var pct = 0;
    if (exp > 0) { pct := (gen * 100) / exp; }
    ("  " + key + ": " + gen + "/" + exp + " (" + pct + "%)").println();
}

var overallRatio = 0;
if (expectedElements > 0) {
    overallRatio := totalGenerated.asReal() / expectedElements;
}

("Total: " + totalGenerated + "/" + expectedElements + " (" + (overallRatio * 100) + "%)").println();

var score = 1;
if (overallRatio >= 0.95) { score := 5; }
else if (overallRatio >= 0.80) { score := 4; }
else if (overallRatio >= 0.60) { score := 3; }
else if (overallRatio >= 0.40) { score := 2; }

("FC Score: " + score + "/5").println();
