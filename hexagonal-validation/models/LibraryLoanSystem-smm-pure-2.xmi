<?xml version="1.0" encoding="UTF-8"?>
<smm:Application xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:smm="smm" xsi:schemaLocation="smm smm.ecore" name="LibraryLoan" basePackage="com.library.loan" javaVersion="21" serverPort="8080">
  <modules name="library">
    <entities name="Book">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="availabilityStatus">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </entities>
    <entities name="Loan">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </entities>
    <entities name="Member">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="fullName">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="membershipDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </entities>
    <entities name="BookCopy">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="barcode">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="conditionStatus">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </entities>
    <valueObjects name="BookMetadata">
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </valueObjects>
    <valueObjects name="PublisherInfo">
      <attributes name="publisherName">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="publicationYear">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </valueObjects>
    <valueObjects name="LoanPeriod">
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="loanDuration">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </valueObjects>
    <valueObjects name="Email">
      <attributes name="address">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </valueObjects>
    <valueObjects name="Phone">
      <attributes name="number">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </valueObjects>
    <repositories name="BookRepository" entityType="//@modules.0/@entities.0">
      <methods name="findByTitle">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType" reference="//@modules.0/@entities.0"/>
        </returnType>
        <parameters name="title">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="existsByIsbn">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="isbn">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="LoanRepository" entityType="//@modules.0/@entities.1">
      <methods name="findByMemberId">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType" reference="//@modules.0/@entities.1"/>
        </returnType>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="MemberRepository" entityType="//@modules.0/@entities.2">
      <methods name="findByEmail">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.2"/>
        <parameters name="email">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="BookCopyRepository" entityType="//@modules.0/@entities.3">
      <methods name="findByBarcode">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.3"/>
        <parameters name="barcode">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </repositories>
    <services name="BookService" requiredRepositories="//@modules.0/@repositories.0">
      <methods name="searchBooks">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.0"/>
        </returnType>
        <parameters name="query">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="checkAvailability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <services name="LoanService" requiredRepositories="//@modules.0/@repositories.1">
      <methods name="createLoan">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="renewLoan">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="returnBook">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <services name="BookCopyService" requiredRepositories="//@modules.0/@repositories.3">
      <methods name="addNewCopy">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.3"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="barcode">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <services name="MemberService" requiredRepositories="//@modules.0/@repositories.2">
      <methods name="registerMember">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.2"/>
        <parameters name="fullName">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="email">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="getMember">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.2"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <services name="AvailabilityService" requiredRepositories="//@modules.0/@repositories.0">
      <methods name="isBookAvailable">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <services name="FineCalculatorService">
      <methods name="calculateFine">
        <returnType xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
        <parameters name="overdueDays">
          <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
        </parameters>
      </methods>
    </services>
    <controllers name="BookController" basePath="/api/books" service="//@modules.0/@services.0">
      <methods xsi:type="smm:Endpoint" name="searchBooks" path="">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.0"/>
        </returnType>
        <parameters name="query" kind="QUERY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="getBook" path="/{id}">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.0"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="LoanController" basePath="/api/loans" service="//@modules.0/@services.1">
      <methods xsi:type="smm:Endpoint" name="requestLoan" httpMethod="POST" path="">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="body" kind="BODY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="returnBook" httpMethod="PUT" path="/{id}/return">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="renewLoan" httpMethod="PUT" path="/{id}/renew">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="MemberController" basePath="/api/members" service="//@modules.0/@services.3">
      <methods xsi:type="smm:Endpoint" name="registerMember" httpMethod="POST" path="">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.2"/>
        <parameters name="body" kind="BODY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="getMember" path="/{id}">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.2"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="BookCopyController" basePath="/api/copies" service="//@modules.0/@services.2">
      <methods xsi:type="smm:Endpoint" name="addBookCopy" httpMethod="POST" path="">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.3"/>
        <parameters name="body" kind="BODY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </controllers>
    <dtos name="BookDTO">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="LoanDTO">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="MemberDTO">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="fullName">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="email">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="BookCopyDTO">
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="barcode">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
  </modules>
</smm:Application>
