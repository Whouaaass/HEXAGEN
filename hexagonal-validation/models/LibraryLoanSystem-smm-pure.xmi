<?xml version="1.0" encoding="UTF-8"?>
<smm:Application
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:smm="smm"
    xsi:schemaLocation="smm smm.ecore"
    name="LibraryLoanSystem"
    basePackage="com.library"
    javaVersion="17"
    serverPort="8080">
  <modules>
    <entities
        name="LoanEntity">
      <attributes
          name="loanId"
          isId="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
      <attributes
          name="status"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="fine"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DOUBLE"/>
      </attributes>
      <attributes
          name="memberRef">
        <type
            xsi:type="smm:CustomType"/>
      </attributes>
      <idType
          xsi:type="smm:PrimitiveType"
          kind="UUID"/>
    </entities>
    <entities
        name="MemberRef">
      <attributes
          name="memberId"
          isId="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
      <idType
          xsi:type="smm:PrimitiveType"
          kind="UUID"/>
    </entities>
    <entities
        name="BookEntity">
      <attributes
          name="bookId"
          isId="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
      <attributes
          name="title">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="author">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="isbn"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="copies">
        <type
            xsi:type="smm:PrimitiveType"
            kind="INTEGER"/>
      </attributes>
      <idType
          xsi:type="smm:PrimitiveType"
          kind="UUID"/>
    </entities>
    <valueObjects
        name="LoanPeriod">
      <attributes
          name="loanDate">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DATE"/>
      </attributes>
      <attributes
          name="dueDate">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DATE"/>
      </attributes>
      <attributes
          name="returnDate"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DATE"/>
      </attributes>
    </valueObjects>
    <valueObjects
        name="BookMetadata"/>
    <repositories
        name="LoanRepository"
        entityType="//@modules.0/@entities.0">
      <idType
          xsi:type="smm:PrimitiveType"
          kind="UUID"/>
    </repositories>
    <repositories
        name="BookRepository"
        entityType="//@modules.0/@entities.2">
      <idType
          xsi:type="smm:PrimitiveType"
          kind="UUID"/>
    </repositories>
    <services
        name="LoanService">
      <methods
          name="requestLoan">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.1"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.0"/>
        </parameters>
      </methods>
      <methods
          name="returnBook">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.3"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.2"/>
        </parameters>
      </methods>
      <methods
          name="renewLoan">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.5"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.4"/>
        </parameters>
      </methods>
      <methods
          name="getLoanHistory">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.7"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.6"/>
        </parameters>
      </methods>
      <methods
          name="calculateFine">
        <returnType
            xsi:type="smm:PrimitiveType"
            kind="DOUBLE"/>
        <parameters
            name="loanId">
          <type
              xsi:type="smm:PrimitiveType"
              kind="UUID"/>
        </parameters>
      </methods>
      <methods
          name="isOverdue">
        <returnType
            xsi:type="smm:PrimitiveType"
            kind="BOOLEAN"/>
        <parameters
            name="loanId">
          <type
              xsi:type="smm:PrimitiveType"
              kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories
          href="//@modules.0/@repositories.0"/>
    </services>
    <services
        name="BookService">
      <methods
          name="searchBook">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.9"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.8"/>
        </parameters>
      </methods>
      <methods
          name="checkAvailability">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.11"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.10"/>
        </parameters>
      </methods>
      <requiredRepositories
          href="//@modules.0/@repositories.1"/>
    </services>
    <controllers
        name="LoanRestController"
        basePath="/loans"
        service="//@modules.0/@services.0">
      <methods
          xsi:type="smm:Endpoint"
          name="requestLoan"
          httpMethod="POST"
          path="/request">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.1"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.0"/>
        </parameters>
      </methods>
      <methods
          xsi:type="smm:Endpoint"
          name="getLoanHistory"
          path="/history">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.7"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.6"/>
        </parameters>
      </methods>
    </controllers>
    <controllers
        name="ReturnBookController"
        basePath="/loans"
        service="//@modules.0/@services.0">
      <methods
          xsi:type="smm:Endpoint"
          name="returnBook"
          httpMethod="POST"
          path="/return">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.3"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.2"/>
        </parameters>
      </methods>
    </controllers>
    <controllers
        name="RenewLoanController"
        basePath="/loans"
        service="//@modules.0/@services.0">
      <methods
          xsi:type="smm:Endpoint"
          name="renewLoan"
          httpMethod="POST"
          path="/renew">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.5"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.4"/>
        </parameters>
      </methods>
    </controllers>
    <controllers
        name="BookRestController"
        basePath="/books"
        service="//@modules.0/@services.1">
      <methods
          xsi:type="smm:Endpoint"
          name="searchBook"
          path="/search">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.9"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.8"/>
        </parameters>
      </methods>
      <methods
          xsi:type="smm:Endpoint"
          name="checkAvailability"
          path="/availability">
        <returnType
            xsi:type="smm:CustomType"
            reference="//@modules.0/@dtos.11"/>
        <parameters
            name="request"
            kind="BODY">
          <type
              xsi:type="smm:CustomType"
              reference="//@modules.0/@dtos.10"/>
        </parameters>
      </methods>
    </controllers>
    <dtos name="LoanRequestDTO">
      <attributes
          name="bookId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
      <attributes
          name="memberId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="LoanResponseDTO">
      <attributes
          name="loanId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
      <attributes
          name="dueDate">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="ReturnBookRequestDTO">
      <attributes
          name="loanId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="ReturnBookResponseDTO">
      <attributes
          name="status"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="fine"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DOUBLE"/>
      </attributes>
    </dtos>
    <dtos name="RenewLoanRequestDTO">
      <attributes
          name="loanId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="RenewLoanResponseDTO">
      <attributes
          name="newDueDate">
        <type
            xsi:type="smm:PrimitiveType"
            kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="LoanHistoryRequestDTO">
      <attributes
          name="memberId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="LoanHistoryResponseDTO">
      <attributes
          name="loans">
        <type
            xsi:type="smm:CollectionType">
          <innerType
              xsi:type="smm:CustomType"
              reference="//@modules.0/@entities.0"/>
        </type>
      </attributes>
    </dtos>
    <dtos name="SearchBookRequestDTO">
      <attributes
          name="title"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes
          name="author"
          isNullable="true">
        <type
            xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="SearchBookResponseDTO">
      <attributes
          name="books">
        <type
            xsi:type="smm:CollectionType">
          <innerType
              xsi:type="smm:CustomType"
              reference="//@modules.0/@entities.2"/>
        </type>
      </attributes>
    </dtos>
    <dtos name="AvailabilityRequestDTO">
      <attributes
          name="bookId">
        <type
            xsi:type="smm:PrimitiveType"
            kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="AvailabilityResponseDTO">
      <attributes
          name="available">
        <type
            xsi:type="smm:PrimitiveType"
            kind="BOOLEAN"/>
      </attributes>
      <attributes
          name="copies">
        <type
            xsi:type="smm:PrimitiveType"
            kind="INTEGER"/>
      </attributes>
    </dtos>
  </modules>
</smm:Application>
