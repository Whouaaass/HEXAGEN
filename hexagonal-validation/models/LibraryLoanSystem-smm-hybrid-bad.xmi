<?xml version="1.0" encoding="UTF-8"?>
<smm:Application xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:smm="smm" xsi:schemaLocation="smm smm.ecore" name="LibraryLoanSystem" basePackage="com.library" javaVersion="21" serverPort="8080">
  <modules name="applicationModule">
    <entities name="Loan">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="fine">
        <type xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </attributes>
      <attributes name="loanPeriod">
        <type xsi:type="smm:CustomType" reference="//@modules.0/@valueObjects.0"/>
      </attributes>
    </entities>
    <entities name="Book">
      <attributes name="bookId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="copies">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
      <attributes name="publisherInfo">
        <type xsi:type="smm:CustomType" reference="//@modules.0/@valueObjects.1"/>
      </attributes>
    </entities>
    <entities name="Member">
      <attributes name="memberId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="name">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="membershipDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="email">
        <type xsi:type="smm:CustomType" reference="//@modules.0/@valueObjects.2"/>
      </attributes>
      <attributes name="phone">
        <type xsi:type="smm:CustomType" reference="//@modules.0/@valueObjects.3"/>
      </attributes>
    </entities>
    <entities name="BookCopy">
      <attributes name="copyId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="barcode">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </entities>
    <valueObjects name="LoanPeriod">
      <attributes name="loanDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="returnDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </valueObjects>
    <valueObjects name="PublisherInfo">
      <attributes name="publisher">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="publicationYear">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </valueObjects>
    <valueObjects name="Email">
      <attributes name="address">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </valueObjects>
    <valueObjects name="Phone">
      <attributes name="number">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </valueObjects>
    <repositories name="LoanRepository" entityType="//@modules.0/@entities.0">
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.0"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findAll"/>
      <methods name="save">
        <parameters name="entity">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@entities.0"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="BookRepository" entityType="//@modules.0/@entities.1">
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.1"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findAll"/>
      <methods name="save">
        <parameters name="entity">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@entities.1"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="MemberRepository" entityType="//@modules.0/@entities.2">
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.2"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findAll"/>
      <methods name="save">
        <parameters name="entity">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@entities.2"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </repositories>
    <repositories name="BookCopyRepository" entityType="//@modules.0/@entities.3">
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@entities.3"/>
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findAll"/>
      <methods name="save">
        <parameters name="entity">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@entities.3"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <parameters name="id">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </repositories>
    <services name="LoanService" requiredRepositories="//@modules.0/@repositories.0">
      <methods name="requestLoan">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="returnBook">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.3"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="renewLoan">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.5"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="getLoanHistory">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.7"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </services>
    <services name="BookService" requiredRepositories="//@modules.0/@repositories.1">
      <methods name="searchBook">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.9"/>
        <parameters name="title">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="author">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="checkAvailability">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.11"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </services>
    <services name="MemberService" requiredRepositories="//@modules.0/@repositories.2">
      <methods name="registerMember">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.13"/>
        <parameters name="name">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="address">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="number">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods name="getMember">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.14"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </services>
    <services name="BookCopyService" requiredRepositories="//@modules.0/@repositories.3">
      <methods name="addBookCopy">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.16"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="barcode">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
    </services>
    <controllers name="LoanController" basePath="api/loans" service="//@modules.0/@services.0">
      <methods xsi:type="smm:Endpoint" name="requestLoan" httpMethod="POST" path="request">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.1"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@dtos.0"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="getLoanHistory" path="history">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.7"/>
        <parameters name="memberId" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="BookController" basePath="api/books" service="//@modules.0/@services.1">
      <methods xsi:type="smm:Endpoint" name="searchBook" path="search">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.9"/>
        <parameters name="title" kind="QUERY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="author" kind="QUERY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="checkAvailability" path="availability">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.11"/>
        <parameters name="bookId" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="ReturnBookController" basePath="api/loans" service="//@modules.0/@services.0">
      <methods xsi:type="smm:Endpoint" name="returnBook" httpMethod="POST" path="return">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.3"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@dtos.2"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="RenewLoanController" basePath="api/loans" service="//@modules.0/@services.0">
      <methods xsi:type="smm:Endpoint" name="renewLoan" httpMethod="POST" path="renew">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.5"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@dtos.4"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="MemberController" basePath="api/members" service="//@modules.0/@services.2">
      <methods xsi:type="smm:Endpoint" name="registerMember" httpMethod="POST" path="register">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.13"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@dtos.12"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="getMember" path="{memberId}">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.14"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </controllers>
    <controllers name="BookCopyController" basePath="api/books" service="//@modules.0/@services.3">
      <methods xsi:type="smm:Endpoint" name="addBookCopy" httpMethod="POST" path="copies">
        <returnType xsi:type="smm:CustomType" reference="//@modules.0/@dtos.16"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="//@modules.0/@dtos.15"/>
        </parameters>
      </methods>
    </controllers>
    <dtos name="LoanRequestDTO">
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="LoanResponseDTO">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="ReturnBookRequestDTO">
      <attributes name="loanId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="ReturnBookResponseDTO">
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="fine">
        <type xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </attributes>
    </dtos>
    <dtos name="RenewLoanRequestDTO">
      <attributes name="loanId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="RenewLoanResponseDTO">
      <attributes name="newDueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="LoanHistoryRequestDTO">
      <attributes name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="LoanHistoryResponseDTO">
      <attributes name="loans">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="SearchBookRequestDTO">
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="SearchBookResponseDTO">
      <attributes name="books">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="AvailabilityRequestDTO">
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
    <dtos name="AvailabilityResponseDTO">
      <attributes name="available">
        <type xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
      </attributes>
      <attributes name="copies">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </dtos>
    <dtos name="RegisterMemberRequestDTO">
      <attributes name="name">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="address">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="number">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="RegisterMemberResponseDTO">
      <attributes name="memberId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="membershipDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="MemberResponseDTO">
      <attributes name="name">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="membershipDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="AddBookCopyRequestDTO">
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="barcode">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
    <dtos name="AddBookCopyResponseDTO">
      <attributes name="copyId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="barcode">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
    </dtos>
  </modules>
</smm:Application>
