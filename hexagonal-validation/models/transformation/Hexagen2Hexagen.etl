rule Hexagon2Application
    transform h : HEXAGEN!Hexagon
    to a : TOP!Application {
    
    a.name = h.name;
    a.basePackage = "co.edu.unicauca." + h.name?.toLowerCase();
    a.javaVersion = "21";
    
    // Transformar los agregados del núcleo
    a.aggregates = h.core.aggregates.equivalent();
}

@lazy
rule AggregateRoot2Aggregate
    transform ar : HEXAGEN!AggregateRoot
    to ta : TOP!Aggregate {
    
    ta.name = ar.name;
    // Mapeo de entidades internas
    ta.entity ::= ar.internalEntities;
    ta.vObj ::= ar.attributes;
}

@lazy
rule Entity2Entity
    transform e : HEXAGEN!Entity
    to te : TOP!Entity {
    
    te.name = e.name;
    // Mapeo de atributos
    te.attributes ::= e.values;    
}

@lazy
rule Attributes2Attributes
	transform at : HEXAGEN!Attribute
	to attr: TOP!Attribute {
	attr.name = at.name;
	attr.type = at.type;
}

@lazy
rule ValueObject2ValueObject
	transform source: HEXAGEN!ValueObject
	to target: TOP!ValueObject {
	target.name = source.name;
	target.attributes ::= source.values;
}