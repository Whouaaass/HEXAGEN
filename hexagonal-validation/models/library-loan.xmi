<?xml version="1.0" encoding="UTF-8"?>
<smm:Application
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:smm="smm"
    xsi:schemaLocation="smm smm.ecore"
    name="LibraryLoan"
    basePackage="com.library.loan"
    javaVersion="21"
    serverPort="8080">
  <modules name="loan">

    <!-- ======== ENTITIES ======== -->

    <entities name="Book" xmi:id="Book">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="publicationInfo">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="availabilityStatus">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </entities>

    <entities name="Loan" xmi:id="Loan">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </entities>

    <!-- ======== VALUE OBJECTS ======== -->

    <valueObjects name="BookMetadata" xmi:id="BookMetadata">
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="publicationInfo">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </valueObjects>

    <valueObjects name="LoanPeriod" xmi:id="LoanPeriod">
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="duration">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </valueObjects>

    <!-- ======== REPOSITORIES ======== -->

    <repositories name="BookRepository" xmi:id="BookRepository">
      <entityType xmi:idref="Book"/>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findByTitle">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Book"/>
          </innerType>
        </returnType>
        <parameters name="title">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods name="findByAuthor">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Book"/>
          </innerType>
        </returnType>
        <parameters name="author">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods name="existsByIsbn">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="isbn">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
    </repositories>

    <repositories name="LoanRepository" xmi:id="LoanRepository">
      <entityType xmi:idref="Loan"/>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findByMemberId">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Loan"/>
          </innerType>
        </returnType>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findByBookIdAndStatus">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="status">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods name="findOverdueLoans">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Loan"/>
          </innerType>
        </returnType>
        <parameters name="currentDate">
          <type xsi:type="smm:PrimitiveType" kind="DATE"/>
        </parameters>
      </methods>
    </repositories>

    <!-- ======== SERVICES ======== -->

    <services name="BookService" xmi:id="BookService">
      <methods name="queryBooks">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Book"/>
          </innerType>
        </returnType>
        <parameters name="query">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods name="checkAvailability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="getBookInfo">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="BookMetadata"/>
        </returnType>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories xmi:idref="BookRepository"/>
    </services>

    <services name="LoanService" xmi:id="LoanService">
      <methods name="createLoan">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="renewLoan">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="returnBook">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories xmi:idref="BookRepository"/>
      <requiredRepositories xmi:idref="LoanRepository"/>
    </services>

    <services name="AvailabilityService" xmi:id="AvailabilityService">
      <methods name="isBookAvailable">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="isBookInCatalog">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="isBookEligible">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories xmi:idref="BookRepository"/>
    </services>

    <services name="FineCalculatorService" xmi:id="FineCalculatorService">
      <methods name="calculateFine">
        <returnType xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="overdueDays">
          <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
        </parameters>
      </methods>
      <requiredRepositories xmi:idref="LoanRepository"/>
    </services>

    <!-- ======== CONTROLLERS (Inbound Adapters) ======== -->

    <controllers name="BookController" basePath="/api/books" xmi:id="BookController">
      <service xmi:idref="BookService"/>
      <methods xsi:type="smm:Endpoint" name="searchBooks" path="/search" httpMethod="GET">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType">
            <reference xmi:idref="Book"/>
          </innerType>
        </returnType>
        <parameters name="query" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="getBookInfo" path="/{id}" httpMethod="GET">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Book"/>
        </returnType>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="checkAvailability" path="/{id}/availability" httpMethod="GET">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </controllers>

    <controllers name="LoanController" basePath="/api/loans" xmi:id="LoanController">
      <service xmi:idref="LoanService"/>
      <methods xsi:type="smm:Endpoint" name="createLoan" path="/" httpMethod="POST">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="loanRequest" kind="BODY">
          <type xsi:type="smm:CustomType">
            <reference xmi:idref="LoanRequest"/>
          </type>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="renewLoan" path="/{id}/renew" httpMethod="PUT">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods xsi:type="smm:Endpoint" name="returnBook" path="/{id}/return" httpMethod="PUT">
        <returnType xsi:type="smm:CustomType">
          <reference xmi:idref="Loan"/>
        </returnType>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
    </controllers>

    <!-- ======== DTOs ======== -->

    <dtos name="BookSearchRequest" xmi:id="BookSearchRequest">
      <attributes name="query">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </dtos>

    <dtos name="LoanRequest" xmi:id="LoanRequest">
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>

  </modules>
</smm:Application>
