<?xml version="1.0" encoding="UTF-8"?>
<smm:Application xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:smm="smm" xsi:schemaLocation="smm smm.ecore" name="LibraryLoanHexagonV2" basePackage="com.library" javaVersion="17" serverPort="8080">
  <modules name="LoanManagement">
    <entities name="LoanEntity">
      <attributes name="loanId" isId="true">
