<?xml version="1.0" encoding="UTF-8"?>
<smm:Application
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:smm="smm"
    xsi:schemaLocation="smm smm.ecore"
    name="LibraryLoanManagementSystem"
    basePackage="com.library.loan"
    javaVersion="21"
    serverPort="8080">
  <modules name="libraryLoan">
    <entities xmi:id="Book" name="Book">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="publicationInfo">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="availabilityStatus">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </entities>
    <entities xmi:id="Loan" name="Loan">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <attributes name="id" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </entities>
    <valueObjects xmi:id="BookMetadata" name="BookMetadata">
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
      <attributes name="publicationInfo">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </valueObjects>
    <valueObjects name="LoanPeriod">
      <attributes name="startDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="duration">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
    </valueObjects>
    <repositories xmi:id="BookRepository" name="BookRepository" entityType="Book">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findAll">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType" reference="Book"/>
        </returnType>
      </methods>
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="Book"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="save">
        <returnType xsi:type="smm:CustomType" reference="Book"/>
        <parameters name="book" kind="BODY">
          <type xsi:type="smm:CustomType" reference="Book"/>
        </parameters>
      </methods>
      <methods name="findByIsbn">
        <returnType xsi:type="smm:CustomType" reference="Book"/>
        <parameters name="isbn" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
    </repositories>
    <repositories xmi:id="LoanRepository" name="LoanRepository" entityType="Loan">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findById">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="save">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="loan" kind="BODY">
          <type xsi:type="smm:CustomType" reference="Loan"/>
        </parameters>
      </methods>
      <methods name="findByMemberId">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType" reference="Loan"/>
        </returnType>
        <parameters name="memberId" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="findOverdueLoans">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType" reference="Loan"/>
        </returnType>
      </methods>
    </repositories>
    <services xmi:id="BookService" name="BookService">
      <methods name="searchBooks">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType" reference="Book"/>
        </returnType>
        <parameters name="query" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </methods>
      <methods name="getBookAvailability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="getBookInfo">
        <returnType xsi:type="smm:CustomType" reference="BookMetadata"/>
        <parameters name="bookId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories>BookRepository</requiredRepositories>
    </services>
    <services xmi:id="LoanService" name="LoanService">
      <methods name="createLoan">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="LoanRequest"/>
        </parameters>
      </methods>
      <methods name="renewLoan">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="loanId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <methods name="returnBook">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="loanId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories>LoanRepository</requiredRepositories>
    </services>
    <services xmi:id="AvailabilityService" name="AvailabilityService">
      <methods name="checkAvailability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="bookId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories>BookRepository</requiredRepositories>
      <requiredRepositories>LoanRepository</requiredRepositories>
    </services>
    <services xmi:id="FineCalculatorService" name="FineCalculatorService">
      <methods name="calculateFine">
        <returnType xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
        <parameters name="loanId" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </methods>
      <requiredRepositories>LoanRepository</requiredRepositories>
    </services>
    <controllers name="BookController" basePath="/books" service="BookService">
      <endpoints name="searchBooks" httpMethod="GET" path="/search">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType" reference="Book"/>
        </returnType>
        <parameters name="query" kind="QUERY">
          <type xsi:type="smm:PrimitiveType" kind="STRING"/>
        </parameters>
      </endpoints>
      <endpoints name="getBookAvailability" httpMethod="GET" path="/{id}/availability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="getBookInfo" httpMethod="GET" path="/{id}">
        <returnType xsi:type="smm:CustomType" reference="BookMetadata"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <controllers name="LoanController" basePath="/loans" service="LoanService">
      <endpoints name="createLoan" httpMethod="POST" path="">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="request" kind="BODY">
          <type xsi:type="smm:CustomType" reference="LoanRequest"/>
        </parameters>
      </endpoints>
      <endpoints name="renewLoan" httpMethod="PUT" path="/{id}/renew">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="returnBook" httpMethod="PUT" path="/{id}/return">
        <returnType xsi:type="smm:CustomType" reference="Loan"/>
        <parameters name="id" kind="PATH">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <dtos xmi:id="LoanRequest" name="LoanRequest">
      <attributes name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
    </dtos>
  </modules>
</smm:Application>
