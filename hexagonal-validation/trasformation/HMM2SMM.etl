rule Hexagon2Application
    transform h : HMM!Hexagon
    to a : SMM!Application {

    a.name        = h.name;
    a.basePackage = "com.example." + h.name.toLowerCase();
    a.javaVersion = "21";
    a.serverPort  = "8080";

    var mod = new SMM!Module;
    mod.name = "ApplicationModule";
    a.modules.add(mod);

    var allAggregates = h.domain.aggregates;

    mod.entities.addAll(allAggregates.collect(a | a.equivalent("AggregateRoot2Entity")));
    mod.repositories.addAll(allAggregates.collect(a | a.equivalent("AggregateRoot2Repository")));

    var allHadEntities = allAggregates
        .collect(a | a.members.select(m | m.isKindOf(HMM!Entity))).flatten();
    mod.entities.addAll(allHadEntities.equivalent());

    var allHadVOs = allAggregates
        .collect(a | a.members.select(m | m.isKindOf(HMM!ValueObject))).flatten();
    mod.valueObjects.addAll(allHadVOs.equivalent());

    for (svc in h.application.services) {
        for (uc in svc.useCases) {
            var idx = 0;
            while (idx < uc.input.size()) {
                var item = uc.input.at(idx);
                if (item.isKindOf(HMM!ValueObject)) {
                    var dto = new SMM!Dto;
                    dto.name = item.name;
                    idx := idx + 1;
                    while (idx < uc.input.size() and uc.input.at(idx).isKindOf(HMM!Attribute)) {
                        var nxt = uc.input.at(idx);
                        var smmAttr = nxt.equivalent("HexAttr2SmmAttr");
                        if (smmAttr.isDefined()) { dto.attributes.add(smmAttr); }
                        idx := idx + 1;
                    }
                    mod.dtos.add(dto);
                } else { idx := idx + 1; }
            }
            var idx2 = 0;
            while (idx2 < uc.output.size()) {
                var item2 = uc.output.at(idx2);
                if (item2.isKindOf(HMM!ValueObject)) {
                    var dto = new SMM!Dto;
                    dto.name = item2.name;
                    idx2 := idx2 + 1;
                    while (idx2 < uc.output.size() and uc.output.at(idx2).isKindOf(HMM!Attribute)) {
                        var nxt = uc.output.at(idx2);
                        var smmAttr = nxt.equivalent("HexAttr2SmmAttr");
                        if (smmAttr.isDefined()) { dto.attributes.add(smmAttr); }
                        idx2 := idx2 + 1;
                    }
                    mod.dtos.add(dto);
                } else { idx2 := idx2 + 1; }
            }
        }
        mod.services.add(svc.equivalent("ApplicationService2Service"));
        var controllers = svc.linkedInboundAdapters();
        mod.controllers.addAll(controllers.equivalent());
    }
}

@lazy
rule AggregateRoot2Entity
    transform agg : HMM!AggregateRoot
    to ent : SMM!Entity {

    ent.name = agg.name + "Entity";

    var idAttr  = new SMM!Attribute;
    var idType  = new SMM!PrimitiveType;
    idType.kind = SMM!PrimitiveKind#UUID;
    idAttr.name = agg.name.firstToLowerCase() + "Id";
    idAttr.type = idType;
    idAttr.isId = true;

    var idType2  = new SMM!PrimitiveType;
    idType2.kind = SMM!PrimitiveKind#UUID;
    ent.idType = idType2;

    ent.attributes.add(idAttr);

    var scalarMembers = agg.members.select(m | m.isKindOf(HMM!Attribute));
    for (attr in scalarMembers) {
        if (attr.name != agg.name.firstToLowerCase() + "Id") {
            var smmAttr = attr.equivalent("HexAttr2SmmAttr");
            if (smmAttr.isDefined()) {
                ent.attributes.add(smmAttr);
            }
        }
    }

    for (rel in agg.rels) {
        var fkAttr  = new SMM!Attribute;
        var fkType  = new SMM!PrimitiveType;
        fkType.kind = SMM!PrimitiveKind#UUID;
        fkAttr.name = rel.target.name.firstToLowerCase() + "Id";
        fkAttr.type = fkType;
        fkAttr.isId = false;
        ent.attributes.add(fkAttr);
    }
}

@lazy
rule AggregateRoot2Repository
    transform agg : HMM!AggregateRoot
    to repo : SMM!Repository {

    repo.name = agg.name + "Repository";
    repo.entityType = agg.equivalent("AggregateRoot2Entity");

    var idType  = new SMM!PrimitiveType;
    idType.kind = SMM!PrimitiveKind#UUID;
    repo.idType = idType;

    var entity = agg.equivalent("AggregateRoot2Entity");

    repo.methods.add(buildMethod("findById",   toCustomType(entity),                     Sequence{ buildParam("id", primitiveType(SMM!PrimitiveKind#UUID), SMM!ParamKind#PATH) }));
    repo.methods.add(buildMethod("findAll",    toCollectionType(entity),                 Sequence{}));
    repo.methods.add(buildMethod("save",       toCustomType(entity),                     Sequence{ buildParam("entity", toCustomType(entity), SMM!ParamKind#BODY) }));
    repo.methods.add(buildMethod("deleteById", primitiveType(SMM!PrimitiveKind#BOOLEAN), Sequence{ buildParam("id", primitiveType(SMM!PrimitiveKind#UUID), SMM!ParamKind#PATH) }));
}

@lazy
rule HadEntity2SmmEntity
    transform he : HMM!Entity
    to se : SMM!Entity {

    se.name = he.name;

    var idType  = new SMM!PrimitiveType;
    idType.kind = SMM!PrimitiveKind#UUID;
    se.idType = idType;

    for (v in he.values) {
        var smmAttr = v.equivalent("HexAttr2SmmAttr");
        if (smmAttr.isDefined()) {
            se.attributes.add(smmAttr);
        }
    }
}

@lazy
rule HadVO2SmmVO
    transform hvo : HMM!ValueObject
    to svo : SMM!ValueObject {

    svo.name = hvo.name;

    for (v in hvo.values) {
        var smmAttr = v.equivalent("HexAttr2SmmAttr");
        if (smmAttr.isDefined()) {
            svo.attributes.add(smmAttr);
        }
    }
}

@lazy
rule ApplicationService2Service
    transform as_ : HMM!ApplicationService
    to svc : SMM!Service {

    svc.name = as_.name;

    var linkedAggregates = as_.linkedAggregates();
    svc.requiredRepositories =
        linkedAggregates.collect(a | SMM!Repository.allInstances().selectOne(r | r.name = a.name + "Repository"));

    for (uc in as_.useCases) {
        var m  = new SMM!Method;
        m.name = uc.name.firstToLowerCase();

        if (uc.output.size() > 0) {
            var firstOut = uc.output.first();
            if (firstOut.isKindOf(HMM!ValueObject)) {
                var dto = findDtoByName(firstOut.name);
                if (dto.isDefined()) {
                    m.returnType = toCustomType(dto);
                } else {
                    m.returnType = resolveTypeFromString("Object");
                }
            } else if (firstOut.isKindOf(HMM!Attribute)) {
                m.returnType = resolveTypeFromString(firstOut.type);
            } else {
                m.returnType = resolveTypeFromString("Object");
            }
        } else {
            m.returnType = resolveTypeFromString("void");
        }

        for (inp in uc.input) {
            if (inp.isKindOf(HMM!ValueObject)) {
                var dto = findDtoByName(inp.name);
                if (dto.isDefined()) {
                    var p = new SMM!Parameter;
                    p.name = inp.name.firstToLowerCase();
                    p.type = toCustomType(dto);
                    p.kind = SMM!ParamKind#BODY;
                    m.parameters.add(p);
                }
            } else if (inp.isKindOf(HMM!Attribute)) {
                var p = new SMM!Parameter;
                p.name = inp.name;
                p.type = resolveTypeFromString(inp.type);
                p.kind = inferParamKind(inp.name);
                m.parameters.add(p);
            }
        }
        svc.methods.add(m);
    }
}

@lazy
rule InboundAdapter2Controller
    transform ia : HMM!InboundAdapter
    to ctrl : SMM!Controller {

    var linkedPort = ia.adapterLinkedPort();
    var ownerSvc   = ia.ownerService();

    if (ownerSvc.isDefined()) {
        ctrl.name     = ia.name;
        ctrl.basePath = buildControllerBasePath(ia.name, linkedPort);

        ctrl.service = ownerSvc.equivalent("ApplicationService2Service");

        var included = ownerSvc.useCases.select(uc | useCaseMatchesPort(uc, linkedPort));
        for (uc in included) {
            ctrl.endpoints.add(buildEndpoint(uc));
        }
    }
}

@lazy
rule HexAttr2SmmAttr
    transform ha : HMM!Attribute
    to sa : SMM!Attribute {

    sa.name       = ha.name;
    sa.type       = resolveTypeFromString(ha.type);
    sa.isNullable = false;
    sa.isId       = false;
}

operation String stripSuffix(suffix : String) : String {
    if (self.endsWith(suffix)) {
        return self.substring(0, self.length() - suffix.length());
    }
    return self;
}

operation String firstToLowerCase() : String {
    if (self.length() = 0) { return self; }
    return self.substring(0, 1).toLowerCase() + self.substring(1);
}

operation resolveTypeFromString(typeName : String) : SMM!Type {
    var t = typeName.trim();
    if (t = "UUID")     { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#UUID;    return p; }
    if (t = "String")   { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#STRING;  return p; }
    if (t = "Integer")  { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#INTEGER; return p; }
    if (t = "Long")     { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#LONG;    return p; }
    if (t = "Boolean")  { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#BOOLEAN; return p; }
    if (t = "Double" or t = "Decimal") { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#DOUBLE; return p; }
    if (t = "DateTime") { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#DATE;    return p; }
    if (t = "void")     { var p = new SMM!PrimitiveType; p.kind = SMM!PrimitiveKind#STRING;  return p; }
    if (t.endsWith("List") or t.endsWith("Set")) {
        var col       = new SMM!CollectionType;
        col.collection = SMM!CollectionKind#LIST;
        var innerCt   = new SMM!CustomType;
        col.innerType = innerCt;
        return col;
    }
    var ct = new SMM!CustomType;
    var entity = SMM!Entity.allInstances().selectOne(e | e.name.toLowerCase() = t.toLowerCase());
    if (entity.isDefined()) {
        ct.reference = entity;
    }
    return ct;
}

operation primitiveType(kind : Any) : SMM!PrimitiveType {
    var p = new SMM!PrimitiveType;
    p.kind = kind;
    return p;
}

operation toCustomType(jc : SMM!JavaClass) : SMM!CustomType {
    var ct = new SMM!CustomType;
    ct.reference = jc;
    return ct;
}

operation toCollectionType(jc : SMM!JavaClass) : SMM!CollectionType {
    var col       = new SMM!CollectionType;
    col.collection = SMM!CollectionKind#LIST;
    col.innerType = toCustomType(jc);
    return col;
}

operation buildMethod(mName : String, retType : SMM!Type, params : Sequence) : SMM!Method {
    var m        = new SMM!Method;
    m.name       = mName;
    m.returnType = retType;
    for (p in params) { m.parameters.add(p); }
    return m;
}

operation buildParam(pName : String, typeRef : Any, kind : Any) : SMM!Parameter {
    var p  = new SMM!Parameter;
    p.name = pName;
    p.kind = kind;
    if (typeRef.isKindOf(SMM!Type)) {
        p.type = typeRef;
    } else {
        var ct = new SMM!CustomType;
        p.type = ct;
    }
    return p;
}

operation inferParamKind(paramName : String) : Any {
    if (paramName.endsWith("Id") or paramName = "id") {
        return SMM!ParamKind#PATH;
    }
    return SMM!ParamKind#BODY;
}

operation buildEndpoint(uc : HMM!UseCase) : SMM!Endpoint {
    var ep   = new SMM!Endpoint;
    ep.name  = uc.name.firstToLowerCase();

    var lcName = uc.name.toLowerCase();
    if (lcName.startsWith("get") or lcName.startsWith("find") or
        lcName.startsWith("search") or lcName.startsWith("check") or
        lcName.startsWith("list") or lcName.startsWith("view")) {
        ep.httpMethod = SMM!HttpMethod#GET;
        ep.path       = "/" + uc.name.firstToLowerCase();
    } else if (lcName.startsWith("create") or lcName.startsWith("request") or
               lcName.startsWith("add")    or lcName.startsWith("register") or
               lcName.startsWith("borrow")) {
        ep.httpMethod = SMM!HttpMethod#POST;
        ep.path       = "/";
    } else if (lcName.startsWith("update") or lcName.startsWith("renew") or
               lcName.startsWith("reschedule")) {
        ep.httpMethod = SMM!HttpMethod#PUT;
        ep.path       = "/{id}";
    } else if (lcName.startsWith("delete") or lcName.startsWith("cancel") or
               lcName.startsWith("remove")) {
        ep.httpMethod = SMM!HttpMethod#DELETE;
        ep.path       = "/{id}";
    } else if (lcName.startsWith("return") or lcName.startsWith("approve") or
               lcName.startsWith("complete")) {
        ep.httpMethod = SMM!HttpMethod#PATCH;
        ep.path       = "/{id}/" + uc.name.firstToLowerCase();
    } else {
        ep.httpMethod = SMM!HttpMethod#POST;
        ep.path       = "/" + uc.name.firstToLowerCase();
    }

    if (uc.output.size() > 0) {
        var firstOut = uc.output.first();
        if (firstOut.isKindOf(HMM!ValueObject)) {
            var dto = findDtoByName(firstOut.name);
            if (dto.isDefined()) {
                ep.returnType = toCustomType(dto);
            } else {
                ep.returnType = resolveTypeFromString("Object");
            }
        } else if (firstOut.isKindOf(HMM!Attribute)) {
            ep.returnType = resolveTypeFromString(firstOut.type);
        } else {
            ep.returnType = resolveTypeFromString("Object");
        }
    } else {
        ep.returnType = resolveTypeFromString("void");
    }

    for (inp in uc.input) {
        if (inp.isKindOf(HMM!ValueObject)) {
            var dto = findDtoByName(inp.name);
            if (dto.isDefined()) {
                var p = new SMM!Parameter;
                p.name = inp.name.firstToLowerCase();
                p.type = toCustomType(dto);
                p.kind = SMM!ParamKind#BODY;
                ep.parameters.add(p);
            }
        } else if (inp.isKindOf(HMM!Attribute)) {
            var p = new SMM!Parameter;
            p.name = inp.name;
            p.type = resolveTypeFromString(inp.type);
            p.kind = inferParamKind(inp.name);
            ep.parameters.add(p);
        }
    }

    return ep;
}

operation findDtoByName(name : String) : SMM!Dto {
    return SMM!Dto.allInstances().selectOne(d | d.name = name);
}

operation HMM!ApplicationService linkedAggregates() : Sequence {
    var hexagon = HMM!Hexagon.allInstances().first();
    return hexagon.links
        .select(l | l.isKindOf(HMM!ServiceAggregateLink) and l.source = self)
        .collect(l | l.target);
}

operation HMM!ApplicationService linkedDomainServices() : Sequence {
    var hexagon = HMM!Hexagon.allInstances().first();
    return hexagon.links
        .select(l | l.isKindOf(HMM!ServiceDomainServiceLink) and l.source = self)
        .collect(l | l.target);
}

operation HMM!ApplicationService linkedInboundAdapters() : Sequence {
    var hexagon   = HMM!Hexagon.allInstances().first();
    var myPorts   = hexagon.links
        .select(l | l.isKindOf(HMM!ServicePortLink) and l.source = self)
        .collect(l | l.target)
        .select(p | p.isKindOf(HMM!InboundPort));

    return hexagon.links
        .select(l | l.isKindOf(HMM!AdapterPortLink)
                    and myPorts.includes(l.target)
                    and l.source.isKindOf(HMM!InboundAdapter))
        .collect(l | l.source);
}

operation HMM!ApplicationService linkedDomainEvents() : Sequence {
    var hexagon         = HMM!Hexagon.allInstances().first();
    var aggregateNames  = self.linkedAggregates().collect(a | a.name.toLowerCase());
    return hexagon.domain.events.select(e |
        aggregateNames.exists(aName | e.name.toLowerCase().contains(aName)))
        .asSequence();
}

operation HMM!InboundAdapter ownerService() : HMM!ApplicationService {
    var hexagon  = HMM!Hexagon.allInstances().first();
    var myPorts  = hexagon.links
        .select(l | l.isKindOf(HMM!AdapterPortLink) and l.source = self)
        .collect(l | l.target);

    var services = hexagon.links
        .select(l | l.isKindOf(HMM!ServicePortLink)
                    and myPorts.includes(l.target))
        .collect(l | l.source);

    if (services.size() > 0) { return services.first(); }
    return null;
}

operation HMM!InboundAdapter adapterLinkedPort() : HMM!Port {
    var hexagon = HMM!Hexagon.allInstances().first();
    var ports = hexagon.links
        .select(l | l.isKindOf(HMM!AdapterPortLink) and l.source = self)
        .collect(l | l.target);
    if (ports.size() > 0) { return ports.first(); }
    return null;
}

operation buildControllerBasePath(ctrlName : String, port : HMM!Port) : String {
    var portName = port.name.toLowerCase();
    var cName    = ctrlName.toLowerCase();

    if (portName.contains("return")) {
        return "/api/loans/{loanId}/return";
    }
    if (portName.contains("renew")) {
        return "/api/loans/{loanId}/renew";
    }
    if (cName.contains("bookcopy")) {
        return "/api/books/{bookId}/copies";
    }

    var base = ctrlName.stripSuffix("RestController").stripSuffix("Controller");
    return "/api/" + base.toLowerCase() + "s";
}

operation useCaseMatchesPort(uc : HMM!UseCase, port : HMM!Port) : Boolean {
    if (port.isUndefined()) { return true; }

    var ucName = uc.name.toLowerCase();
    var portName = port.name.toLowerCase();

    if (portName.contains("request")) {
        return ucName.startsWith("request") or ucName.startsWith("get")
            or ucName.startsWith("list") or ucName.startsWith("view")
            or ucName.startsWith("search") or ucName.startsWith("find");
    }
    if (portName.contains("return")) {
        return ucName.startsWith("return");
    }
    if (portName.contains("renew")) {
        return ucName.startsWith("renew");
    }
    if (portName.contains("query")) {
        return ucName.startsWith("search") or ucName.startsWith("check")
            or ucName.startsWith("find") or ucName.startsWith("list");
    }

    return true;
}
