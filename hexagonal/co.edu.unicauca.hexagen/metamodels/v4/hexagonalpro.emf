@namespace(uri="http://co.edu.unicauca.hexagen.hexagonal", prefix="p")
package hexagonal_ddd;

class Hexagon {
	attr String name;
	val InfrastructureLayer[1] infrastructure;
	val ApplicationLayer[1] application;
	val DomainCore[1] domain;
	val HexagonLink[*] links;
	val ExternalSystem[*] externalSystems;
}


// Infrastructure
class InfrastructureLayer {
	attr String name;
	val Port[*] ports;
	val Adapter[*] adapters;
}

abstract class Port {
	attr String name;
}

class InboundPort extends Port {
}

class OutboundPort extends Port {
}

abstract class Adapter {
	attr String name;
}

class InboundAdapter extends Adapter {
}

class OutboundAdapter extends Adapter {
}

class ExternalSystem {
	attr String name;
}

// Application
class ApplicationLayer {
	attr String name;
	val ApplicationService[*] services;
}

class ApplicationService {
	attr String name;
	val UseCase[*] useCases;
}

class UseCase {
	attr String name;
	val DomainObject[*] input;
	val DomainObject[*] output;
}

// Domain
class DomainCore {
	attr String name;
	val AggregateRoot[*] aggregates;
	val DomainService[*] domainServices;
	val DomainEvent[*] events;
	val DomainObject[*] objects;
}

abstract class DomainObject {
	attr String name;
}

class Attribute extends DomainObject {
	attr String type;
}

class AggregateRoot extends DomainObject {
	val DomainObject[*] members;
}

class Entity extends DomainObject {
	val Attribute[*] values;
}

class ValueObject extends DomainObject {
	val Attribute[*] values; 
}

class DomainOperation extends DomainObject {
	attr String returnType;
}

class DomainService {
	attr String name;
	val DomainOperation[*] operations;
}

class DomainEvent {
	attr String name;
	attr String occurredOn;
	val Attribute[*] payload;
}

abstract class HexagonLink {
	attr String name;
	attr String description;
}

// Links
class AdapterPortLink extends HexagonLink {
	ref Adapter[1] source;
	ref Port[1] target;
}

class ExternalSystemLink extends HexagonLink {
	ref ExternalSystem[1] source;
	ref Adapter[1] target;
}

class ServicePortLink extends HexagonLink {
	ref ApplicationService[1] source;
	ref Port[1] target;
}

class ServiceAggregateLink extends HexagonLink {
	ref ApplicationService[1] source;
	ref AggregateRoot[1] target;
}

class ServiceDomainServiceLink extends HexagonLink {
	ref ApplicationService[1] source;
	ref DomainService[1] target;
}

