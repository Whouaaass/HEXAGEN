@startuml
skinparam packageStyle rectangle
  package "Infrastructure Layer" as INFRA {
        () "LibraryPortal" as LibraryPortal <<inbound>>
          () "PersistencePort" as PersistencePort <<outbound>>
   
      component "LibraryController" as LibraryController <<adapter>>
      component "LibraryRepository" as LibraryRepository <<adapter>>
  }
  
    component "WebClient" as WebClient <<external>>
    component "Database" as Database <<external>>
  
  package "Application Layer" as APP {
      component "LibraryService" as LibraryService <<service>> {
          usecase BorrowBook
          usecase ReturnBook
      }
  }
  
  package "Domain Core" as DOMAIN {
      package "Loan" as Loan <<aggregate>> {
            component "LoanRecord" as LoanRecord <<entity>>
      }
    
      component "FineCalculator" as FineCalculator <<domain-service>>
    
      component "BookBorrowed" as BookBorrowed <<event>>
      component "BookReturned" as BookReturned <<event>>
  }
  
      LibraryController --> LibraryPortal
      LibraryRepository --> PersistencePort
      WebClient --> LibraryController
      LibraryRepository --> Database
      LibraryService --> LibraryPortal
      LibraryService --> PersistencePort
      LibraryService --> Loan
      LibraryService --> FineCalculator
@enduml
