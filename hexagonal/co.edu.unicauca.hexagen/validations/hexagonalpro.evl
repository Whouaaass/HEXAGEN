/**
 * hexagonalpro Validation Module
 * Restricciones que garantizan que cualquier instancia del modelo sea correcta
 * Metamodelo: Hexagonal DDD (HAD) — versión actualizada
 */

/**
-- ═══════════════════════════════════════════════════════════
-- HEXAGON — estructura global
-- ═══════════════════════════════════════════════════════════
*/
context Hexagon {

    constraint CapasCompletas {
        check: self.infrastructure.isDefined()
            and self.application.isDefined()
            and self.domain.isDefined()
        message: "El Hexagon '" + self.name +
            "' debe tener exactamente una InfrastructureLayer, " +
            "una ApplicationLayer y un DomainCore."
    }

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "El Hexagon debe tener un nombre no vacío."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- DOMAINCORE — reglas de dominio puro
-- ═══════════════════════════════════════════════════════════
*/

context DomainCore {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "DomainCore debe tener un nombre no vacío."
    }

    constraint ContieneAgregados {
        check: self.aggregates.size() >= 1
        message: "DomainCore '" + self.name +
            "' debe contener al menos un AggregateRoot."
    }

    /**Dominio aislado: no puede referenciar capas externas*/
    constraint DominioAislado {
        check: not self.aggregates->exists(a |
                ApplicationService.allInstances()->includes(a)
                or Adapter.allInstances()->includes(a)
                or Port.allInstances()->includes(a))
            and not self.domainServices->exists(ds |
                ApplicationService.allInstances()->includes(ds)
                or Adapter.allInstances()->includes(ds))
        message: "DomainCore '" + self.name +
            "' contiene referencias a elementos de ApplicationLayer " +
            "o InfrastructureLayer. El dominio no puede conocer " +
            "ninguna capa externa — es la regla fundamental de DDD."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- AGGREGATEROOT
-- ═══════════════════════════════════════════════════════════
*/
context AggregateRoot {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo AggregateRoot debe tener un nombre no vacío."
    }

/**
     CORREGIDO: antes usaba internalEntities y attributes,
     ahora el metamodelo unifica todo en members: DomainObject[*]*/
    constraint AgregadoNoVacio {
        check: self.members.size() >= 1
        message: "AggregateRoot '" + self.name +
            "' debe contener al menos un miembro DomainObject. " +
            "Un agregado vacío no modela ningún concepto de negocio."
    }

    /** Al menos un miembro debe ser Entity o ValueObject*/
    constraint AgregadoConEntidadOValor {
        check: self.members->exists(m |
            m.isTypeOf(Entity) or m.isTypeOf(ValueObject))
        message: "AggregateRoot '" + self.name +
            "' debe contener al menos una Entity o un ValueObject. " +
            "Un agregado solo de atributos no representa un concepto de negocio."
    }

    /** Nombres únicos dentro de members*/
    constraint MiembrosConNombreUnico {
        check: self.members
            .collect(m | m.name)
            .size() =
               self.members
            .collect(m | m.name)
            .asSet()
            .size()
        message: "AggregateRoot '" + self.name +
            "' tiene miembros con nombres duplicados."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- DOMAINOBJECT — subclases: Entity, ValueObject, Attribute,
--                DomainOperation
-- ═══════════════════════════════════════════════════════════
*/

context Entity {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Toda Entity debe tener un nombre no vacío."
    }

    /** CORREGIDO: antes verificaba internalEntities, ahora members*/
    constraint SoloEnAgregado {
        check: AggregateRoot.allInstances()
            ->exists(a | a.members->includes(self))
        message: "Entity '" + self.name +
            "' debe estar contenida dentro de un AggregateRoot. " +
            "Las entidades no pueden existir fuera del agregado."
    }
}

context ValueObject {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ValueObject debe tener un nombre no vacío."
    }

    /** CORREGIDO: antes verificaba attributes, ahora members*/
    constraint SoloEnAgregado {
        check: AggregateRoot.allInstances()
            ->exists(a | a.members->includes(self))
            or DomainCore.allInstances()
            ->exists(d | d.objects->includes(self))
        message: "ValueObject '" + self.name +
            "' debe estar contenido dentro de un AggregateRoot " +
            "o registrado en DomainCore.objects."
    }
}

context Attribute {

    constraint NombreYTipoValidos {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
            and self.type.isDefined()
            and self.type.trim().length() > 0
        message: "Attribute '" + self.name +
            "' debe tener name y type definidos y no vacíos."
    }

    /** Tipos de infraestructura no permitidos en el dominio*/
    constraint TipoNoDeCapa {
        check: not Sequence{
                "HttpRequest", "HttpResponse", "EntityManager",
                "DataSource", "Connection", "HttpServletRequest"}
            ->exists(t | self.type = t)
        message: "Attribute '" + self.name +
            "' usa el tipo '" + self.type +
            "' que pertenece a infraestructura. " +
            "Los atributos del dominio solo pueden usar tipos primitivos " +
            "o tipos propios del dominio."
    }
}

/** NUEVO: DomainOperation es ahora subclase de DomainObject*/
context DomainOperation {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Toda DomainOperation debe tener un nombre no vacío."
    }

    constraint ReturnTypeValido {
        check: self.returnType.isDefined()
            and self.returnType.trim().length() > 0
        message: "DomainOperation '" + self.name +
            "' debe tener un returnType definido y no vacío."
    }

    /** Solo puede existir dentro de un DomainService*/
    constraint SoloEnDomainService {
        check: DomainService.allInstances()
            ->exists(ds | ds.operations->includes(self))
        message: "DomainOperation '" + self.name +
            "' debe estar contenida dentro de un DomainService."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- DOMAINSERVICE
-- ═══════════════════════════════════════════════════════════
*/

context DomainService {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo DomainService debe tener un nombre no vacío."
    }

    constraint ConOperaciones {
        check: self.operations.size() >= 1
        message: "DomainService '" + self.name +
            "' debe tener al menos una operación definida. " +
            "Un servicio de dominio sin operaciones no encapsula ninguna regla."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- DOMAINEVENT
-- ═══════════════════════════════════════════════════════════
*/ 

context DomainEvent {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo DomainEvent debe tener un nombre no vacío."
    }

    constraint OcurridoEnDefinido {
        check: self.occurredOn.isDefined()
            and self.occurredOn.trim().length() > 0
        message: "DomainEvent '" + self.name +
            "' debe tener el campo occurredOn definido. " +
            "Todo evento debe registrar cuándo ocurrió."
    }

    constraint PayloadNoVacio {
        check: self.payload.size() >= 1
        message: "DomainEvent '" + self.name +
            "' debe tener al menos un atributo en el payload. " +
            "Un evento sin datos no permite que el receptor reaccione."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- APPLICATIONLAYER
-- ═══════════════════════════════════════════════════════════
*/

context ApplicationLayer {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "ApplicationLayer debe tener un nombre no vacío."
    }

    constraint ContieneServicios {
        check: self.services.size() >= 1
        message: "ApplicationLayer '" + self.name +
            "' debe contener al menos un ApplicationService."
    }

    constraint AppSoloComunicaViaLinks {
        check: not self.services->exists(svc |
                Adapter.allInstances()->exists(a | svc = a)
                or Port.allInstances()->exists(p | svc = p))
        message: "ApplicationLayer '" + self.name +
            "' contiene referencias directas a InfrastructureLayer. " +
            "La comunicación entre capas debe hacerse vía HexagonLink."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- APPLICATIONSERVICE y USECASE
-- ═══════════════════════════════════════════════════════════
*/

context ApplicationService {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ApplicationService debe tener un nombre no vacío."
    }

    constraint ConCasosDeUso {
        check: self.useCases.size() >= 1
        message: "ApplicationService '" + self.name +
            "' debe tener al menos un UseCase."
    }

    constraint CasosDeUsoConNombreUnico {
        check: self.useCases
            .collect(u | u.name)
            .size() =
               self.useCases
            .collect(u | u.name)
            .asSet()
            .size()
        message: "ApplicationService '" + self.name +
            "' tiene casos de uso con nombres duplicados."
    }
}

context UseCase {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo UseCase debe tener un nombre no vacío."
    }

    constraint ConInput {
        check: self.input.size() >= 1
        message: "UseCase '" + self.name +
            "' debe tener al menos un atributo de entrada."
    }

    constraint ConOutput {
        check: self.output.size() >= 1
        message: "UseCase '" + self.name +
            "' debe tener al menos un atributo de salida."
    }
}

/**
-- NUEVO: UseCaseParameter reemplaza Attribute en la capa de aplicación*/
context UseCaseParameter {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo UseCaseParameter debe tener un nombre no vacío."
    }

    constraint TipoValido {
        check: self.type.isDefined()
            and self.type.trim().length() > 0
        message: "UseCaseParameter '" + self.name +
            "' debe tener un type definido y no vacío."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- INFRASTRUCTURELAYER — puertos y adaptadores
-- ═══════════════════════════════════════════════════════════
*/
context InfrastructureLayer {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "InfrastructureLayer debe tener un nombre no vacío."
    }

    constraint ConPuertoDeEntrada {
        check: self.ports->exists(p | p.isTypeOf(InboundPort))
        message: "InfrastructureLayer '" + self.name +
            "' debe tener al menos un InboundPort."
    }

    constraint ConAdaptadores {
        check: self.adapters.size() >= 1
        message: "InfrastructureLayer '" + self.name +
            "' debe tener al menos un Adapter."
    }
}

context Port {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo Port debe tener un nombre no vacío."
    }

    constraint PuertoReferenciado {
        check: AdapterPortLink.allInstances()
                ->exists(l | l.target = self)
            or ServicePortLink.allInstances()
                ->exists(l | l.target = self)
        message: "Port '" + self.name +
            "' no está referenciado por ningún link. " +
            "Un puerto sin uso no cumple ninguna función."
    }
}

context Adapter {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo Adapter debe tener un nombre no vacío."
    }

    constraint VinculadoAUnPuerto {
        check: AdapterPortLink.allInstances()
            ->select(l | l.source = self)
            ->size() = 1
        message: "Adapter '" + self.name +
            "' debe estar vinculado a exactamente un Port " +
            "mediante AdapterPortLink."
    }
}

/**
-- ═══════════════════════════════════════════════════════════
-- CLASES DE RELACIÓN — integridad referencial
-- ═══════════════════════════════════════════════════════════
*/
context AdapterPortLink {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo AdapterPortLink debe tener un nombre no vacío."
    }

    constraint TiposDeFlujoConsistentes {
        check: (self.source.isTypeOf(InboundAdapter)
                    implies self.target.isTypeOf(InboundPort))
            and (self.source.isTypeOf(OutboundAdapter)
                    implies self.target.isTypeOf(OutboundPort))
        message: "AdapterPortLink '" + self.name +
            "': InboundAdapter solo con InboundPort y " +
            "OutboundAdapter solo con OutboundPort."
    }

    constraint SourceYTargetDefinidos {
        check: self.source.isDefined()
            and self.target.isDefined()
        message: "AdapterPortLink '" + self.name +
            "' debe tener source y target definidos."
    }
}

context ExternalSystemLink {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ExternalSystemLink debe tener un nombre no vacío."
    }

    constraint ExternoSoloViaAdaptador {
        check: self.target.isKindOf(Adapter)
        message: "ExternalSystemLink '" + self.name +
            "': el target debe ser un Adapter. " +
            "Un ExternalSystem nunca accede directamente al dominio."
    }

    constraint SourceYTargetDefinidos {
        check: self.source.isDefined()
            and self.target.isDefined()
        message: "ExternalSystemLink '" + self.name +
            "' debe tener source y target definidos."
    }
}

context ServicePortLink {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ServicePortLink debe tener un nombre no vacío."
    }

    constraint SourceYTargetDefinidos {
        check: self.source.isDefined()
            and self.target.isDefined()
        message: "ServicePortLink '" + self.name +
            "' debe tener source y target definidos."
    }

    constraint PuertoEnMismoHexagon {
        check: Hexagon.allInstances()
            ->exists(h |
                h.links->includes(self)
                and h.infrastructure.ports->includes(self.target))
        message: "ServicePortLink '" + self.name +
            "': el Port debe pertenecer al InfrastructureLayer " +
            "del mismo Hexagon."
    }
}

context ServiceAggregateLink {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ServiceAggregateLink debe tener un nombre no vacío."
    }

    constraint SourceYTargetDefinidos {
        check: self.source.isDefined()
            and self.target.isDefined()
        message: "ServiceAggregateLink '" + self.name +
            "' debe tener source y target definidos."
    }

    constraint AgregadoEnMismoHexagon {
        check: Hexagon.allInstances()
            ->exists(h |
                h.links->includes(self)
                and h.domain.aggregates->includes(self.target))
        message: "ServiceAggregateLink '" + self.name +
            "': el AggregateRoot debe pertenecer al DomainCore " +
            "del mismo Hexagon."
    }
}

context ServiceDomainServiceLink {

    constraint NombreValido {
        check: self.name.isDefined()
            and self.name.trim().length() > 0
        message: "Todo ServiceDomainServiceLink debe tener un nombre no vacío."
    }

    constraint SourceYTargetDefinidos {
        check: self.source.isDefined()
            and self.target.isDefined()
        message: "ServiceDomainServiceLink '" + self.name +
            "' debe tener source y target definidos."
    }

    constraint DomainServiceEnMismoHexagon {
        check: Hexagon.allInstances()
            ->exists(h |
                h.links->includes(self)
                and h.domain.domainServices->includes(self.target))
        message: "ServiceDomainServiceLink '" + self.name +
            "': el DomainService debe pertenecer al DomainCore " +
            "del mismo Hexagon."
    }
}