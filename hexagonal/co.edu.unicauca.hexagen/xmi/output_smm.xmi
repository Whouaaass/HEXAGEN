<?xml version="1.0" encoding="ASCII"?>
<smm:Application xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:smm="smm" xsi:schemaLocation="smm ../metamodels/smm.ecore" name="LibraryLoanHexagonV2" basePackage="co.edu.unicauca.libraryloanhexagonv2" javaVersion="21" serverPort="8080">
  <modules name="Loan">
    <entities name="Loan">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <entities name="LoanEntity">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="status">
        <type xsi:type="smm:CustomType"/>
      </attributes>
      <attributes name="fine">
        <type xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <entities name="BookRef">
      <attributes name="bookId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <entities name="MemberRef">
      <attributes name="memberId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <valueObjects name="LoanPeriod">
      <attributes name="loanDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="returnDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </valueObjects>
    <repositories name="LoanRepository" entityType="//@modules.0/@entities.0">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findById">
        <returnType xsi:type="smm:PrimitiveType" kind="UUID"/>
        <parameters name="id">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
      <methods name="findAll">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType"/>
        </returnType>
      </methods>
      <methods name="save">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="entity" kind="BODY">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="id">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
    </repositories>
    <services name="FineCalculatorService">
      <methods name="calculateFine">
        <returnType xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </methods>
      <methods name="isOverdue">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
      </methods>
    </services>
    <controllers name="LoanRestController" basePath="/loans" service="//@modules.1">
      <endpoints name="requestLoan" httpMethod="POST" path="/">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="returnBook" httpMethod="PATCH" path="/{id}/returnBook">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="renewLoan" httpMethod="PUT" path="/{id}">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="getLoanHistory" path="/getLoanHistory">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <controllers name="ReturnBookController" basePath="/returnbooks" service="//@modules.1">
      <endpoints name="requestLoan" httpMethod="POST" path="/">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="returnBook" httpMethod="PATCH" path="/{id}/returnBook">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="renewLoan" httpMethod="PUT" path="/{id}">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="getLoanHistory" path="/getLoanHistory">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <controllers name="RenewLoanController" basePath="/renewloans" service="//@modules.1">
      <endpoints name="requestLoan" httpMethod="POST" path="/">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="returnBook" httpMethod="PATCH" path="/{id}/returnBook">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="renewLoan" httpMethod="PUT" path="/{id}">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="loanId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
      <endpoints name="getLoanHistory" path="/getLoanHistory">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="memberId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <dtos name="LoanRequestedDto">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="bookId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="memberId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="loanDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
    </dtos>
    <dtos name="LoanOverdueDto">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="dueDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="fine">
        <type xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </attributes>
    </dtos>
  </modules>
  <modules xsi:type="smm:Service" name="LoanService" requiredRepositories="//@modules.0/@repositories.0">
    <methods name="requestLoan">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
      <parameters name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
    </methods>
    <methods name="returnBook">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="loanId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
    </methods>
    <methods name="renewLoan">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="loanId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
    </methods>
    <methods name="getLoanHistory">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="memberId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
    </methods>
  </modules>
  <modules name="Book">
    <entities name="Book">
      <attributes name="bookId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <entities name="BookEntity">
      <attributes name="bookId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="author">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="isbn">
        <type xsi:type="smm:PrimitiveType"/>
      </attributes>
      <attributes name="copies">
        <type xsi:type="smm:PrimitiveType" kind="INTEGER"/>
      </attributes>
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
    </entities>
    <valueObjects name="BookMetadata"/>
    <repositories name="BookRepository" entityType="//@modules.2/@entities.0">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findById">
        <returnType xsi:type="smm:PrimitiveType" kind="UUID"/>
        <parameters name="id">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
      <methods name="findAll">
        <returnType xsi:type="smm:CollectionType">
          <innerType xsi:type="smm:CustomType"/>
        </returnType>
      </methods>
      <methods name="save">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="entity" kind="BODY">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
      <methods name="deleteById">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
        <parameters name="id">
          <type xsi:type="smm:CustomType"/>
        </parameters>
      </methods>
    </repositories>
    <services name="AvailabilityService">
      <methods name="checkAvailability">
        <returnType xsi:type="smm:PrimitiveType" kind="BOOLEAN"/>
      </methods>
      <methods name="reserveCopy">
        <returnType xsi:type="smm:PrimitiveType"/>
      </methods>
    </services>
    <controllers name="BookRestController" basePath="/books" service="//@modules.3">
      <endpoints name="searchBook" path="/searchBook">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="title" kind="BODY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
        <parameters name="author" kind="BODY">
          <type xsi:type="smm:PrimitiveType"/>
        </parameters>
      </endpoints>
      <endpoints name="checkAvailability" path="/checkAvailability">
        <returnType xsi:type="smm:CustomType"/>
        <parameters name="bookId">
          <type xsi:type="smm:PrimitiveType" kind="UUID"/>
        </parameters>
      </endpoints>
    </controllers>
    <dtos name="BookReturnedDto">
      <attributes name="loanId" isId="true">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="returnDate">
        <type xsi:type="smm:PrimitiveType" kind="DATE"/>
      </attributes>
      <attributes name="fine">
        <type xsi:type="smm:PrimitiveType" kind="DOUBLE"/>
      </attributes>
    </dtos>
  </modules>
  <modules xsi:type="smm:Service" name="BookService" requiredRepositories="//@modules.2/@repositories.0">
    <methods name="searchBook">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="title" kind="BODY">
        <type xsi:type="smm:PrimitiveType"/>
      </parameters>
      <parameters name="author" kind="BODY">
        <type xsi:type="smm:PrimitiveType"/>
      </parameters>
    </methods>
    <methods name="checkAvailability">
      <returnType xsi:type="smm:CustomType"/>
      <parameters name="bookId">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </parameters>
    </methods>
  </modules>
</smm:Application>
