<?xml version="1.0" encoding="UTF-8"?>
<p:Hexagon
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:p="http://co.edu.unicauca.hexagen.hexagonal"
    xsi:schemaLocation="http://co.edu.unicauca.hexagen.hexagonal hexagonal_ddd.ecore"
    name="LibraryLoanHexagon">

  <!-- ═══════════════════════════════════════════ -->
  <!-- EXTERNAL SYSTEMS                            -->
  <!-- índices: .0=RESTClient .1=RelationalDB .2=SMTPServer -->
  <!-- ═══════════════════════════════════════════ -->
  <externalSystems name="RESTClient"/>
  <externalSystems name="RelationalDB"/>
  <externalSystems name="SMTPServer"/>

  <!-- ═══════════════════════════════════════════ -->
  <!-- INFRASTRUCTURE LAYER                        -->
  <!-- ports:    .0=LoanRequestPort                -->
  <!--           .1=BookQueryPort                  -->
  <!--           .2=ReturnBookPort                 -->
  <!--           .3=LoanRepositoryPort             -->
  <!--           .4=BookRepositoryPort             -->
  <!--           .5=NotificationPort               -->
  <!-- adapters: .0=LoanRestController             -->
  <!--           .1=BookRestController             -->
  <!--           .2=LoanORMRepository              -->
  <!--           .3=BookORMRepository              -->
  <!--           .4=EmailNotificationAdapter       -->
  <!-- ═══════════════════════════════════════════ -->
  <infrastructure name="Infrastructure">

    <ports xsi:type="p:InboundPort"  name="LoanRequestPort"/>
    <ports xsi:type="p:InboundPort"  name="BookQueryPort"/>
    <ports xsi:type="p:InboundPort"  name="ReturnBookPort"/>

    <ports xsi:type="p:OutboundPort" name="LoanRepositoryPort"/>
    <ports xsi:type="p:OutboundPort" name="BookRepositoryPort"/>
    <ports xsi:type="p:OutboundPort" name="NotificationPort"/>

    <adapters xsi:type="p:InboundAdapter"  name="LoanRestController"/>
    <adapters xsi:type="p:InboundAdapter" name="ReturnBookController"/>
    <adapters xsi:type="p:InboundAdapter"  name="BookRestController"/>

    <adapters xsi:type="p:OutboundAdapter" name="LoanORMRepository"/>
    <adapters xsi:type="p:OutboundAdapter" name="BookORMRepository"/>
    <adapters xsi:type="p:OutboundAdapter" name="EmailNotificationAdapter"/>

  </infrastructure>

  <!-- ═══════════════════════════════════════════ -->
  <!-- APPLICATION LAYER                           -->
  <!-- services: .0=LoanService .1=BookService     -->
  <!-- ═══════════════════════════════════════════ -->
  <application name="Application">

    <services name="LoanService">
      <useCases name="RequestLoan">
        <input  name="bookId"   type="UUID"/>
        <input  name="memberId" type="UUID"/>
        <output name="loanId"   type="UUID"/>
        <output name="dueDate"  type="DateTime"/>
      </useCases>
      <useCases name="ReturnBook">
        <input  name="loanId" type="UUID"/>
        <output name="status" type="LoanStatus"/>
        <output name="fine"   type="Decimal"/>
      </useCases>
      <useCases name="RenewLoan">
        <input  name="loanId"     type="UUID"/>
        <output name="newDueDate" type="DateTime"/>
      </useCases>
      <useCases name="GetLoanHistory">
        <input  name="memberId" type="UUID"/>
        <output name="loans"    type="LoanList"/>
      </useCases>
    </services>

    <services name="BookService">
      <useCases name="SearchBook">
        <input  name="title"  type="String"/>
        <input  name="author" type="String"/>
        <output name="books"  type="BookList"/>
      </useCases>
      <useCases name="CheckAvailability">
        <input  name="bookId"    type="UUID"/>
        <output name="available" type="Boolean"/>
        <output name="copies"    type="Integer"/>
      </useCases>
    </services>

  </application>

  <!-- ═══════════════════════════════════════════ -->
  <!-- DOMAIN CORE                                 -->
  <!-- aggregates:     .0=Loan  .1=Book            -->
  <!-- domainServices: .0=FineCalculatorService    -->
  <!--                 .1=AvailabilityService      -->
  <!-- events:         .0=LoanRequested            -->
  <!--                 .1=BookReturned             -->
  <!--                 .2=LoanOverdue              -->
  <!-- ═══════════════════════════════════════════ -->
  <domain name="Domain">

    <aggregates name="Loan">
      <members xsi:type="p:Attribute"   name="loanId"     type="UUID"/>
      <members xsi:type="p:Attribute"   name="status"     type="LoanStatus"/>
      <members xsi:type="p:Attribute"   name="loanDate"   type="DateTime"/>
      <members xsi:type="p:Attribute"   name="dueDate"    type="DateTime"/>
      <members xsi:type="p:Attribute"   name="returnDate" type="DateTime"/>
      <members xsi:type="p:Attribute"   name="fine"       type="Decimal"/>
      <members xsi:type="p:Entity"      name="LoanEntity"/>
      <members xsi:type="p:ValueObject" name="LoanPeriod"/>
    </aggregates>

    <aggregates name="Book">
      <members xsi:type="p:Attribute"   name="bookId"  type="UUID"/>
      <members xsi:type="p:Attribute"   name="title"   type="String"/>
      <members xsi:type="p:Attribute"   name="author"  type="String"/>
      <members xsi:type="p:Attribute"   name="isbn"    type="String"/>
      <members xsi:type="p:Attribute"   name="copies"  type="Integer"/>
      <members xsi:type="p:Entity"      name="BookEntity"/>
      <members xsi:type="p:ValueObject" name="BookMetadata"/>
    </aggregates>

    <domainServices name="FineCalculatorService">
      <operations name="calculateFine" returnType="Decimal"/>
      <operations name="isOverdue"     returnType="Boolean"/>
    </domainServices>

    <domainServices name="AvailabilityService">
      <operations name="checkAvailability" returnType="Boolean"/>
      <operations name="reserveCopy"       returnType="void"/>
    </domainServices>

    <events name="LoanRequested" occurredOn="2026-05-21T00:00:00Z">
      <payload name="loanId"   type="UUID"/>
      <payload name="bookId"   type="UUID"/>
      <payload name="memberId" type="UUID"/>
      <payload name="loanDate" type="DateTime"/>
    </events>

    <events name="BookReturned" occurredOn="2026-05-21T00:00:00Z">
      <payload name="loanId"     type="UUID"/>
      <payload name="returnDate" type="DateTime"/>
      <payload name="fine"       type="Decimal"/>
    </events>

    <events name="LoanOverdue" occurredOn="2026-05-21T00:00:00Z">
      <payload name="loanId"  type="UUID"/>
      <payload name="dueDate" type="DateTime"/>
      <payload name="fine"    type="Decimal"/>
    </events>

  </domain>

  <!-- ═══════════════════════════════════════════ -->
  <!-- CROSS-LAYER LINKS                           -->
  <!-- ═══════════════════════════════════════════ -->

  <!-- AdapterPortLink -->
  <links xsi:type="p:AdapterPortLink"
      name="LoanControllerToLoanRequestPort"
      description="LoanRestController expone el InboundPort de prestamo"
      source="//@infrastructure/@adapters.0"
      target="//@infrastructure/@ports.0"/>
      
  <links xsi:type="p:AdapterPortLink"
    name="ReturnBookControllerToReturnBookPort"
    source="//@infrastructure/@adapters.1"   
    target="//@infrastructure/@ports.2"/>
    
  <links xsi:type="p:AdapterPortLink"
      name="BookControllerToBookQueryPort"
      description="BookRestController expone el InboundPort de consulta"
      source="//@infrastructure/@adapters.2"
      target="//@infrastructure/@ports.1"/>

  <links xsi:type="p:AdapterPortLink"
      name="LoanRepoToLoanRepositoryPort"
      description="LoanORMRepository implementa el OutboundPort de prestamos"
      source="//@infrastructure/@adapters.3"
      target="//@infrastructure/@ports.3"/>

  <links xsi:type="p:AdapterPortLink"
      name="BookRepoToBookRepositoryPort"
      description="BookORMRepository implementa el OutboundPort de libros"
      source="//@infrastructure/@adapters.4"
      target="//@infrastructure/@ports.4"/>

  <links xsi:type="p:AdapterPortLink"
      name="EmailAdapterToNotificationPort"
      description="EmailNotificationAdapter implementa el OutboundPort de notificaciones"
      source="//@infrastructure/@adapters.5"
      target="//@infrastructure/@ports.5"/>

  <!-- ExternalSystemLink -->
  <links xsi:type="p:ExternalSystemLink"
      name="RESTClientToLoanController"
      description="Cliente REST llama al LoanRestController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.0"/>

  <links xsi:type="p:ExternalSystemLink"
      name="RESTClientToBookController"
      description="Cliente REST llama al BookRestController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.1"/>

  <links xsi:type="p:ExternalSystemLink"
      name="DBToLoanRepo"
      description="Base de datos relacional usada por LoanORMRepository"
      source="//@externalSystems.1"
      target="//@infrastructure/@adapters.2"/>

  <links xsi:type="p:ExternalSystemLink"
      name="DBToBookRepo"
      description="Base de datos relacional usada por BookORMRepository"
      source="//@externalSystems.1"
      target="//@infrastructure/@adapters.3"/>

  <links xsi:type="p:ExternalSystemLink"
      name="SMTPToEmailAdapter"
      description="Servidor SMTP usado por EmailNotificationAdapter"
      source="//@externalSystems.2"
      target="//@infrastructure/@adapters.4"/>

  <!-- ServicePortLink -->
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceToLoanRequestPort"
      description="LoanService recibe llamadas por LoanRequestPort"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.0"/>

  <links xsi:type="p:ServicePortLink"
      name="LoanServiceToReturnBookPort"
      description="LoanService recibe devoluciones por ReturnBookPort"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.2"/>

  <links xsi:type="p:ServicePortLink"
      name="LoanServiceToLoanRepositoryPort"
      description="LoanService persiste prestamos via LoanRepositoryPort"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.3"/>

  <links xsi:type="p:ServicePortLink"
      name="LoanServiceToNotificationPort"
      description="LoanService envia notificaciones via NotificationPort"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.5"/>

  <links xsi:type="p:ServicePortLink"
      name="BookServiceToBookQueryPort"
      description="BookService recibe consultas por BookQueryPort"
      source="//@application/@services.1"
      target="//@infrastructure/@ports.1"/>

  <links xsi:type="p:ServicePortLink"
      name="BookServiceToBookRepositoryPort"
      description="BookService consulta libros via BookRepositoryPort"
      source="//@application/@services.1"
      target="//@infrastructure/@ports.4"/>

  <!-- ServiceAggregateLink -->
  <links xsi:type="p:ServiceAggregateLink"
      name="LoanServiceToLoanAggregate"
      description="LoanService coordina el agregado Loan"
      source="//@application/@services.0"
      target="//@domain/@aggregates.0"/>

  <links xsi:type="p:ServiceAggregateLink"
      name="BookServiceToBookAggregate"
      description="BookService coordina el agregado Book"
      source="//@application/@services.1"
      target="//@domain/@aggregates.1"/>

  <!-- ServiceDomainServiceLink -->
  <links xsi:type="p:ServiceDomainServiceLink"
      name="LoanServiceToFineCalculator"
      description="LoanService invoca FineCalculatorService"
      source="//@application/@services.0"
      target="//@domain/@domainServices.0"/>

  <links xsi:type="p:ServiceDomainServiceLink"
      name="BookServiceToAvailability"
      description="BookService invoca AvailabilityService"
      source="//@application/@services.1"
      target="//@domain/@domainServices.1"/>

</p:Hexagon>