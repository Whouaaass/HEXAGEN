<?xml version="1.0" encoding="UTF-8"?>
<p:Hexagon xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:p="http://co.edu.unicauca.hexagen.hexagonal"
    xsi:schemaLocation="http://co.edu.unicauca.hexagen.hexagonal ../metamodels/v4/hexagonalpro.ecore"
    name="LibraryLoanHexagonV2">
  <infrastructure
      name="Infrastructure">
    <ports xsi:type="p:InboundPort"
        name="LoanRequestPort"/>
    <ports xsi:type="p:InboundPort"
        name="BookQueryPort"/>
    <ports xsi:type="p:InboundPort"
        name="ReturnBookPort"/>
    <ports xsi:type="p:InboundPort"
        name="RenewLoanPort"/>
    <ports xsi:type="p:OutboundPort"
        name="LoanRepositoryPort"/>
    <ports xsi:type="p:OutboundPort"
        name="BookRepositoryPort"/>
    <ports xsi:type="p:OutboundPort"
        name="NotificationPort"/>
    <adapters
        xsi:type="p:InboundAdapter"
        name="LoanRestController"/>
    <adapters
        xsi:type="p:InboundAdapter"
        name="BookRestController"/>
    <adapters
        xsi:type="p:InboundAdapter"
        name="ReturnBookController"/>
    <adapters
        xsi:type="p:InboundAdapter"
        name="RenewLoanController"/>
    <adapters
        xsi:type="p:OutboundAdapter"
        name="LoanORMRepository"/>
    <adapters
        xsi:type="p:OutboundAdapter"
        name="BookORMRepository"/>
    <adapters
        xsi:type="p:OutboundAdapter"
        name="EmailNotificationAdapter"/>
  </infrastructure>
  <application
      name="Application">
    <services
        name="LoanService">
      <useCases
          name="RequestLoan">
        <input
            xsi:type="p:ValueObject"
            name="LoanRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="bookId"
            type="UUID"/>
        <input
            xsi:type="p:Attribute"
            name="memberId"
            type="UUID"/>
        <output
            xsi:type="p:ValueObject"
            name="LoanResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="loanId"
            type="UUID"/>
        <output
            xsi:type="p:Attribute"
            name="dueDate"
            type="DateTime"/>
      </useCases>
      <useCases
          name="ReturnBook">
        <input
            xsi:type="p:ValueObject"
            name="ReturnBookRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="loanId"
            type="UUID"/>
        <output
            xsi:type="p:ValueObject"
            name="ReturnBookResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="status"
            type="LoanStatus"/>
        <output
            xsi:type="p:Attribute"
            name="fine"
            type="Decimal"/>
      </useCases>
      <useCases
          name="RenewLoan">
        <input
            xsi:type="p:ValueObject"
            name="RenewLoanRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="loanId"
            type="UUID"/>
        <output
            xsi:type="p:ValueObject"
            name="RenewLoanResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="newDueDate"
            type="DateTime"/>
      </useCases>
      <useCases
          name="GetLoanHistory">
        <input
            xsi:type="p:ValueObject"
            name="LoanHistoryRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="memberId"
            type="UUID"/>
        <output
            xsi:type="p:ValueObject"
            name="LoanHistoryResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="loans"
            type="LoanList"/>
      </useCases>
    </services>
    <services
        name="BookService">
      <useCases
          name="SearchBook">
        <input
            xsi:type="p:ValueObject"
            name="SearchBookRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="title"
            type="String"/>
        <input
            xsi:type="p:Attribute"
            name="author"
            type="String"/>
        <output
            xsi:type="p:ValueObject"
            name="SearchBookResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="books"
            type="BookList"/>
      </useCases>
      <useCases
          name="CheckAvailability">
        <input
            xsi:type="p:ValueObject"
            name="AvailabilityRequestDTO"/>
        <input
            xsi:type="p:Attribute"
            name="bookId"
            type="UUID"/>
        <output
            xsi:type="p:ValueObject"
            name="AvailabilityResponseDTO"/>
        <output
            xsi:type="p:Attribute"
            name="available"
            type="Boolean"/>
        <output
            xsi:type="p:Attribute"
            name="copies"
            type="Integer"/>
      </useCases>
    </services>
  </application>
  <domain name="Domain">
    <aggregates
        name="Loan">
      <members
          xsi:type="p:Entity"
          name="LoanEntity">
        <values
            name="loanId"
            type="UUID"/>
        <values
            name="status"
            type="LoanStatus"/>
        <values
            name="fine"
            type="Decimal"/>
      </members>
      <members
          xsi:type="p:Entity"
          name="MemberRef">
        <values
            name="memberId"
            type="UUID"/>
      </members>
      <members
          xsi:type="p:ValueObject"
          name="LoanPeriod">
        <values
            name="loanDate"
            type="DateTime"/>
        <values
            name="dueDate"
            type="DateTime"/>
        <values
            name="returnDate"
            type="DateTime"/>
      </members>
    </aggregates>
    <aggregates
        name="Book">
      <members
          xsi:type="p:Entity"
          name="BookEntity">
        <values
            name="bookId"
            type="UUID"/>
        <values
            name="title"
            type="String"/>
        <values
            name="author"
            type="String"/>
        <values
            name="isbn"
            type="String"/>
        <values
            name="copies"
            type="Integer"/>
      </members>
      <members
          xsi:type="p:ValueObject"
          name="BookMetadata"/>
    </aggregates>
    <domainServices
        name="FineCalculatorService">
      <operations
          name="calculateFine"
          returnType="Decimal"/>
      <operations
          name="isOverdue"
          returnType="Boolean"/>
    </domainServices>
    <domainServices
        name="AvailabilityService">
      <operations
          name="checkAvailability"
          returnType="Boolean"/>
      <operations
          name="reserveCopy"
          returnType="void"/>
    </domainServices>
    <events
        name="LoanRequested">
      <payload
          name="loanId"
          type="UUID"/>
      <payload
          name="bookId"
          type="UUID"/>
      <payload
          name="memberId"
          type="UUID"/>
      <payload
          name="loanDate"
          type="DateTime"/>
    </events>
    <events
        name="BookReturned">
      <payload
          name="loanId"
          type="UUID"/>
      <payload
          name="returnDate"
          type="DateTime"/>
      <payload
          name="fine"
          type="Decimal"/>
    </events>
    <events
        name="LoanOverdue">
      <payload
          name="loanId"
          type="UUID"/>
      <payload
          name="dueDate"
          type="DateTime"/>
      <payload
          name="fine"
          type="Decimal"/>
    </events>
  </domain>
  <links xsi:type="p:AdapterPortLink"
      name="LoanControllerToPort"
      source="//@infrastructure/@adapters.0"
      target="//@infrastructure/@ports.0"/>
  <links xsi:type="p:AdapterPortLink"
      name="BookControllerToPort"
      source="//@infrastructure/@adapters.1"
      target="//@infrastructure/@ports.1"/>
  <links xsi:type="p:AdapterPortLink"
      name="ReturnControllerToPort"
      source="//@infrastructure/@adapters.2"
      target="//@infrastructure/@ports.2"/>
  <links xsi:type="p:AdapterPortLink"
      name="RenewControllerToPort"
      source="//@infrastructure/@adapters.3"
      target="//@infrastructure/@ports.3"/>
  <links xsi:type="p:AdapterPortLink"
      name="LoanRepoToPort"
      source="//@infrastructure/@adapters.4"
      target="//@infrastructure/@ports.4"/>
  <links xsi:type="p:AdapterPortLink"
      name="BookRepoToPort"
      source="//@infrastructure/@adapters.5"
      target="//@infrastructure/@ports.5"/>
  <links xsi:type="p:AdapterPortLink"
      name="EmailToPort"
      source="//@infrastructure/@adapters.6"
      target="//@infrastructure/@ports.6"/>
  <links xsi:type="p:ExternalSystemLink"
      name="RestClientToLoanController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.0"/>
  <links xsi:type="p:ExternalSystemLink"
      name="RestClientToBookController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.1"/>
  <links xsi:type="p:ExternalSystemLink"
      name="RestClientToReturnController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.2"/>
  <links xsi:type="p:ExternalSystemLink"
      name="RestClientToRenewController"
      source="//@externalSystems.0"
      target="//@infrastructure/@adapters.3"/>
  <links xsi:type="p:ExternalSystemLink"
      name="DBToLoanRepo"
      source="//@externalSystems.1"
      target="//@infrastructure/@adapters.4"/>
  <links xsi:type="p:ExternalSystemLink"
      name="DBToBookRepo"
      source="//@externalSystems.1"
      target="//@infrastructure/@adapters.5"/>
  <links xsi:type="p:ExternalSystemLink"
      name="SMTPToEmail"
      source="//@externalSystems.2"
      target="//@infrastructure/@adapters.6"/>
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceExposesInbound"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.0"/>
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceExposesReturn"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.2"/>
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceExposesRenewal"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.3"/>
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceCallsRepo"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.4"/>
  <links xsi:type="p:ServicePortLink"
      name="LoanServiceCallsNotification"
      source="//@application/@services.0"
      target="//@infrastructure/@ports.6"/>
  <links xsi:type="p:ServicePortLink"
      name="BookServiceExposesQuery"
      source="//@application/@services.1"
      target="//@infrastructure/@ports.1"/>
  <links xsi:type="p:ServicePortLink"
      name="BookServiceCallsRepo"
      source="//@application/@services.1"
      target="//@infrastructure/@ports.5"/>
  <links xsi:type="p:ServiceAggregateLink"
      name="LoanServiceToLoanAggregate"
      source="//@application/@services.0"
      target="//@domain/@aggregates.0"/>
  <links xsi:type="p:ServiceAggregateLink"
      name="BookServiceToBookAggregate"
      source="//@application/@services.1"
      target="//@domain/@aggregates.1"/>
  <links xsi:type="p:ServiceDomainServiceLink"
      name="LoanServiceToFineCalculator"
      source="//@application/@services.0"
      target="//@domain/@domainServices.0"/>
  <links xsi:type="p:ServiceDomainServiceLink"
      name="BookServiceToAvailability"
      source="//@application/@services.1"
      target="//@domain/@domainServices.1"/>
  <externalSystems
      name="RESTClient"/>
  <externalSystems
      name="RelationalDB"/>
  <externalSystems
      name="SMTPServer"/>
</p:Hexagon>
